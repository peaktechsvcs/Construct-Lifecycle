{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens in the W3C Design Tokens (DTCG) format. THIS FILE IS THE SINGLE SOURCE OF TRUTH for the design system. Edit values here only -- do not hand-edit the generated src/index.css or src/generated/tokens.ts. The dev server regenerates them on every change (scripts/build-tokens.mjs, wired through vite.config.ts). Colors are authored as hex; the generator converts them to `H S% L%` channels for the web theme and keeps hex for mobile (tokens.ts). Every color role exists in both light and dark.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#fafafa" },
      "foreground": { "$value": "#0f172a" },
      "border": { "$value": "#e2e8f0" },
      "card": { "$value": "#ffffff" },
      "cardForeground": { "$value": "#0f172a" },
      "popover": { "$value": "#ffffff" },
      "popoverForeground": { "$value": "#0f172a" },
      "primary": {
        "$value": "#2563eb",
        "$description": "Construct Lifecycle vivid blue. Drives primary actions, links, focus, and lifecycle emphasis."
      },
      "primaryForeground": { "$value": "#f8fafc" },
      "secondary": { "$value": "#f1f5f9" },
      "secondaryForeground": { "$value": "#0f172a" },
      "muted": { "$value": "#f1f5f9" },
      "mutedForeground": { "$value": "#64748b" },
      "accent": { "$value": "#f59e0b" },
      "accentForeground": { "$value": "#0f172a" },
      "destructive": { "$value": "#ef4444" },
      "destructiveForeground": { "$value": "#f8fafc" },
      "input": { "$value": "#e2e8f0" },
      "ring": { "$value": "#2563eb" },
      "chart1": { "$value": "#2563eb" },
      "chart2": { "$value": "#0284c7" },
      "chart3": { "$value": "#22c55e" },
      "chart4": { "$value": "#f59e0b" },
      "chart5": { "$value": "#ef4444" },
      "sidebar": { "$value": "#0f172a" },
      "sidebarForeground": { "$value": "#f8fafc" },
      "sidebarBorder": { "$value": "#1e293b" },
      "sidebarPrimary": { "$value": "#2563eb" },
      "sidebarPrimaryForeground": { "$value": "#f8fafc" },
      "sidebarAccent": { "$value": "#1e293b" },
      "sidebarAccentForeground": { "$value": "#f8fafc" },
      "sidebarRing": { "$value": "#3b82f6" }
    },
    "dark": {
      "background": { "$value": "#0f172a" },
      "foreground": { "$value": "#f8fafc" },
      "border": { "$value": "#1e293b" },
      "card": { "$value": "#0f172a" },
      "cardForeground": { "$value": "#f8fafc" },
      "popover": { "$value": "#0f172a" },
      "popoverForeground": { "$value": "#f8fafc" },
      "primary": { "$value": "#3b82f6" },
      "primaryForeground": { "$value": "#0f172a" },
      "secondary": { "$value": "#1e293b" },
      "secondaryForeground": { "$value": "#f8fafc" },
      "muted": { "$value": "#1e293b" },
      "mutedForeground": { "$value": "#94a3b8" },
      "accent": { "$value": "#fbbf24" },
      "accentForeground": { "$value": "#0f172a" },
      "destructive": { "$value": "#991b1b" },
      "destructiveForeground": { "$value": "#f8fafc" },
      "input": { "$value": "#1e293b" },
      "ring": { "$value": "#3b82f6" },
      "chart1": { "$value": "#3b82f6" },
      "chart2": { "$value": "#0ea5e9" },
      "chart3": { "$value": "#22c55e" },
      "chart4": { "$value": "#fbbf24" },
      "chart5": { "$value": "#ef4444" },
      "sidebar": { "$value": "#0f172a" },
      "sidebarForeground": { "$value": "#f8fafc" },
      "sidebarBorder": { "$value": "#1e293b" },
      "sidebarPrimary": { "$value": "#3b82f6" },
      "sidebarPrimaryForeground": { "$value": "#0f172a" },
      "sidebarAccent": { "$value": "#1e293b" },
      "sidebarAccentForeground": { "$value": "#f8fafc" },
      "sidebarRing": { "$value": "#3b82f6" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Inter", "sans-serif"],
        "$description": "Default UI and body typeface."
      },
      "serif": { "$value": ["Georgia", "serif"] },
      "mono": { "$value": ["DM Mono", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.5rem",
      "$description": "Base corner radius; sm/md/lg/xl derive from this in the theme."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step components multiply."
    }
  }
}
