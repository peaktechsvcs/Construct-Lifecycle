modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "run", "release:verify"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "dependency-audit"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "clc-design-system"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "clean-database-migrations"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "feature-control-schema"

[[workflows.workflow]]
name = "dependency-audit"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run audit:dependencies"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "clc-design-system"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/clc-projects run validate:design-system"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "clean-database-migrations"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run validate:clean-database"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "feature-control-schema"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run check:feature-control-schema"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[nix]
channel = "stable-25_05"
packages = ["tesseract", "clamav"]

[objectStorage]
defaultBucketID = "replit-objstore-c4c0d7a4-d434-44a6-9397-626d1ab173cb"

[userenv]

[userenv.development]
VITE_STRIPE_PRICING_TABLE_ID = "prctbl_1UEZ70Gm6tfr5re5q5BaWON8"
VITE_STRIPE_PUBLISHABLE_KEY = "pk_test_51UEWUqGm6tfr5re5YXPeeiYvYzY8VaF73xXq6kpFK5ZTkrS7Mh20cJJGWQks2AuQx6MCT66x9NnXn2fTkEn05ctf00SphtV19o"
STRIPE_PRICING_TABLE_ID = "prctbl_1UEZ70Gm6tfr5re5q5BaWON8"
STRIPE_PUBLISHABLE_KEY = "pk_test_51UEWUqGm6tfr5re5YXPeeiYvYzY8VaF73xXq6kpFK5ZTkrS7Mh20cJJGWQks2AuQx6MCT66x9NnXn2fTkEn05ctf00SphtV19o"
